# Copy to .env and fill in ONE provider. Or leave it empty and connect a model from the UI ("Model" button).
#
# LLM_PROVIDER: openai | anthropic | gemini | azure | bedrock | openai_compatible | rules
#   (if unset, it is inferred from whichever key below is present)
LLM_PROVIDER=

# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Google Gemini (via its OpenAI-compatible endpoint) -------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Azure OpenAI -----------------------------------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- AWS Bedrock (IAM keys, or AWS_BEARER_TOKEN_BEDROCK, or your AWS profile) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# --- Any OpenAI-compatible server: Ollama, LM Studio, OpenRouter, Groq, vLLM ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1        (from Docker: http://host.docker.internal:11434/v1)
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=                                   (optional for local servers)

# --- Generic overrides (work with any provider) -----------------------------
# LLM_MODEL=
# LLM_API_KEY=
# LLM_BASE_URL=

# --- Demo behaviour -----------------------------------------------------------
# "today" for the claims system; fixture deadlines are in early 2026
DEMO_TODAY=2026-03-05
MAX_VERIFY_FAILURES=3
OFF_TOPIC_LIMIT=3
# set false on a public deployment
ALLOW_UI_LLM_CONFIG=true

# --- Optional real email (otherwise emails show in the app) ----------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=claims-support@example.com
# deliver every email here (demo customers have fake addresses)
SMTP_REDIRECT_TO=

# --- Hosting a public demo ------------------------------------------------------
# Models visitors may use on the server's key (comma-separated); empty = any. Others need their own key.
SERVER_KEY_MODELS=
# Per-visitor limits, requests/seconds
# Leave unset for local use. Recommended for a public demo:
# RATE_LIMITS=chat=40/600,session=20/600,model=20/600
